# Backend API base URL (required)
DADIH_API_URL=http://localhost:3000/api
# Set to true only when the production backend is reachable exclusively over a trusted private HTTP network.
# DADIH_ALLOW_HTTP=true

# Docker Compose: the external network shared with the dadih-server container.
# DADIH_NETWORK=dadih-network

# Trusted browser origin of this dashboard.
# REQUIRED in production (fail closed if missing); optional in development.
APP_ORIGIN=http://localhost:3000

# Optional limits (defaults shown)
# MAX_JSON_BYTES=1048576
# MAX_UPLOAD_BYTES=31457280
# MAX_FILE_BYTES=10485760
# PAYOUT_UPSTREAM_TIMEOUT_MS=60000

# Browser-side timeout for remittance send/pay requests (default 80000ms).
# NEXT_PUBLIC_SEND_TIMEOUT_MS=80000

# DEV/Test only: force the execute-generic (send/pay) proxy request to pause
# long enough that the upstream timeout fires, so the timeout-recovery UX can
# be exercised locally without a slow backend. Never active in production.
# DEV_SIMULATE_EXECUTE_TIMEOUT=true
# DEV_SIMULATE_EXECUTE_TIMEOUT_MS=60000

# Optional rate limits (best-effort, per serverless instance)
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_IP_RATE_MAX=10
# ACTION_RATE_MAX=30
# ACTION_RATE_WINDOW_MS=60000
