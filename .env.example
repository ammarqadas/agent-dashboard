# Backend API base URL (required)
DADIH_API_URL=http://localhost:3000/api

# Trusted browser origin of this dashboard.
# REQUIRED in production (fail closed if missing); optional in development.
APP_ORIGIN=http://localhost:3000

# Optional limits (defaults shown)
# MAX_JSON_BYTES=1048576
# MAX_UPLOAD_BYTES=31457280
# MAX_FILE_BYTES=10485760
# PAYOUT_UPSTREAM_TIMEOUT_MS=60000

# Optional rate limits (best-effort, per serverless instance)
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_IP_RATE_MAX=10
# ACTION_RATE_MAX=30
# ACTION_RATE_WINDOW_MS=60000
